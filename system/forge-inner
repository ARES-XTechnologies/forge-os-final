#!/bin/bash
# FORGE OS — runs inside Gamescope.
# Starts Steam silently in the background (games launch through it), then runs the
# console UI. If the UI crashes it comes straight back; if it keeps crashing, Steam
# Big Picture takes over so the console is never stuck on a black screen.

LOG="$HOME/.local/share/forge/logs/shell.log"
ACTION_FILE="$XDG_RUNTIME_DIR/forge-action"
INTENT_FILE="$XDG_RUNTIME_DIR/forge-intent"   # written by the UI just before it closes
FIRST_FILE="$XDG_RUNTIME_DIR/forge-first-boot-done"
SHELL_DIR="/opt/forge/shell"

export FORGE_SESSION=1    # the console UI knows it's running as the real console session
# The console's own X display: forge-fsr sets FSR on gamescope through it, also from games
# that run on gamescope's second display.
export FORGE_X_DISPLAY="$DISPLAY"

# In-game performance overlay / benchmark logging for every game (controlled by Settings).
export MANGOHUD=1
export MANGOHUD_CONFIGFILE="$HOME/.config/MangoHud/MangoHud.conf"
# Better frame pacing on NVIDIA under Gamescope
export __GL_THREADED_OPTIMIZATIONS=1
export __GL_SHADER_DISK_CACHE_SKIP_CLEANUP=1
export STEAM_FORCE_DESKTOPUI_SCALING=1

# Steam is NOT started with the console (it covered the intro and slowed start-up). FORGE
# starts it quietly the first time you play a Steam game or open the Steam app. Here we only
# write queued Steam settings (Proton versions, launch options, FSR, account switch) while
# Steam is closed, so it picks them up when it does start.
prepare_steam() {
	if ! pgrep -x steam >/dev/null; then
		timeout -k 3 20 godot --headless --path "$SHELL_DIR" -- --apply-pending >> "$LOG" 2>&1
	fi
}

steam_shutdown() {
	# Ask Steam to close (games save), wait up to 10 s, then make sure it's gone.
	if pgrep -x steam >/dev/null; then
		timeout 5 steam -shutdown >/dev/null 2>&1 &
		for _ in $(seq 1 20); do
			pgrep -x steam >/dev/null || break
			sleep 0.5
		done
		pkill -x steam 2>/dev/null
		sleep 1
		pkill -9 -x steam 2>/dev/null
	fi
}

big_picture() {
	# Hand the screen to Steam Big Picture. FORGE returns when Steam exits
	# (Big Picture › Power › Exit Steam).
	echo "[forge] switching to Big Picture" >> "$LOG"
	steam_shutdown
	pkill -x steam 2>/dev/null
	sleep 1
	prepare_steam
	steam -gamepadui >> "$HOME/.local/share/forge/logs/steam.log" 2>&1
}

# The UI's import cache (fonts, pictures, effects in .godot/) must be complete, or FORGE
# shows the wrong font and missing parts. It's rebuilt after every update; if that was
# interrupted (power cut, forced restart), rebuild it now before the UI starts.
import_ok() {
	local imp="$SHELL_DIR/.godot/imported"
	[ -f "$SHELL_DIR/.godot/forge-import.ok" ] || return 1
	[ -d "$imp" ] || return 1
	# no empty (half-written) files
	[ -z "$(find "$imp" -type f -size 0 -print -quit 2>/dev/null)" ] || return 1
	# every resource that needs importing has its imported file
	local n_src n_imp
	n_src=$(find "$SHELL_DIR" -path "$SHELL_DIR/.godot" -prune -o -name '*.import' -print | wc -l)
	n_imp=$(find "$imp" -type f ! -name '*.md5' | wc -l)
	[ "$n_imp" -ge "$n_src" ]
}
if ! import_ok; then
	echo "[forge] import cache incomplete: rebuilding it" >> "$LOG"
	rm -f "$SHELL_DIR/.godot/forge-import.ok"
	if timeout -k 5 600 godot --headless --path "$SHELL_DIR" --import >> "$LOG" 2>&1; then
		sync
		touch "$SHELL_DIR/.godot/forge-import.ok"
		sync
	fi
fi

prepare_steam
# Start at native resolution with normal scaling (FSR is switched on per game).
/usr/lib/forge/forge-fsr --reset >/dev/null 2>&1

crashes=0
while true; do
	ARGS=(--path "$SHELL_DIR" --rendering-method mobile)
	# The particle intro plays once per boot; restarts go straight to Home.
	if [ -f "$FIRST_FILE" ]; then
		USER_ARGS=(-- --no-intro)
	else
		USER_ARGS=()
		touch "$FIRST_FILE"
	fi
	started=$(date +%s)
	rm -f "$INTENT_FILE"
	# No performance overlay on FORGE itself: while a game runs, FORGE stays on screen as a
	# see-through layer, and its own counter showed up next to the game's (two overlays).
	MANGOHUD=0 godot "${ARGS[@]}" "${USER_ARGS[@]}" >> "$LOG" 2>&1
	code=$?
	echo "[forge] shell exited with $code" >> "$LOG"
	# Force-closed by its watchdog (it hung while closing): carry out what it was doing.
	case $code in 42|43|44|45) ;; *)
		intent=$(cat "$INTENT_FILE" 2>/dev/null)
		case "$intent" in 42|43|44|45) echo "[forge] closing hung; doing $intent anyway" >> "$LOG"; code=$intent ;; esac ;;
	esac
	rm -f "$INTENT_FILE"
	case $code in
		42) steam_shutdown; echo restart > "$ACTION_FILE"; exit 0 ;;
		43) big_picture; continue ;;
		44) steam_shutdown; echo poweroff > "$ACTION_FILE"; exit 0 ;;
		45) steam_shutdown; echo reboot > "$ACTION_FILE"; exit 0 ;;
		0)  crashes=0; continue ;;
	esac
	if [ $(( $(date +%s) - started )) -lt 15 ]; then
		crashes=$((crashes + 1))
	else
		crashes=0
	fi
	if [ "$crashes" -ge 3 ]; then
		echo "[forge] the console UI keeps crashing; falling back to Big Picture" >> "$LOG"
		crashes=0
		big_picture
	fi
	sleep 0.5
done
