#!/bin/bash
# FORGE OS — runs games you added yourself.
#   forge-run windows <prefix-dir> <proton> <game-id> <exe> [args...]
#       proton: ""          → latest UMU-Proton (downloaded automatically the first time)
#               "GE-Proton" → latest GE-Proton (downloaded automatically)
#               /path/to/proton-dir → a specific Proton (e.g. one Steam installed)
#   forge-run linux <file> [args...]
#   forge-run prepare <proton>      → download/prepare Proton ahead of time
set -u
LOG="$HOME/.local/share/forge/logs/games.log"
mkdir -p "$(dirname "$LOG")"
export MANGOHUD=1
export MANGOHUD_CONFIGFILE="$HOME/.config/MangoHud/MangoHud.conf"
# Every game starts through forge-fsr: with FSR off it simply runs the game.
FSR=/usr/lib/forge/forge-fsr
[ -x "$FSR" ] || FSR=""

mode="${1:-}"; shift || true
case "$mode" in
	windows)
		prefix="$1"; proton="$2"; gameid="$3"; exe="$4"; shift 4
		mkdir -p "$prefix"
		export WINEPREFIX="$prefix"
		export GAMEID="${gameid:-umu-default}"
		export STORE="none"
		export FORGE_APPID="-$(basename "$prefix")"     # matches the game's FORGE id for per-game FSR
		[ -n "$proton" ] && export PROTONPATH="$proton"
		cd "$(dirname "$exe")" || exit 1
		echo "[$(date '+%F %T')] windows: $exe (proton='${proton:-UMU-Proton}', id=$GAMEID)" >> "$LOG"
		case "${exe,,}" in
			*.bat|*.cmd) exec $FSR umu-run cmd /c "$exe" "$@" >> "$LOG" 2>&1 ;;
			*.msi)       exec $FSR umu-run msiexec /i "$exe" "$@" >> "$LOG" 2>&1 ;;
			*)           exec $FSR umu-run "$exe" "$@" >> "$LOG" 2>&1 ;;
		esac
		;;
	linux)
		file="$1"; shift
		cd "$(dirname "$file")" || exit 1
		chmod +x "$file" 2>/dev/null
		echo "[$(date '+%F %T')] linux: $file" >> "$LOG"
		case "$file" in
			*.sh) exec $FSR bash "$file" "$@" >> "$LOG" 2>&1 ;;
			*)    exec $FSR "$file" "$@" >> "$LOG" 2>&1 ;;
		esac
		;;
	prepare)
		proton="${1:-}"
		tmp="$HOME/.local/share/forge/prefixes/_prepare"
		mkdir -p "$tmp"
		export WINEPREFIX="$tmp" GAMEID="umu-default" STORE="none"
		[ -n "$proton" ] && export PROTONPATH="$proton"
		echo "[$(date '+%F %T')] preparing Proton '${proton:-UMU-Proton}'" >> "$LOG"
		umu-run wineboot -u >> "$LOG" 2>&1
		;;
	*)
		echo "usage: forge-run windows|linux|prepare ..." >&2
		exit 2
		;;
esac
