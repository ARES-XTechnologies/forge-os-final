#!/bin/bash
# FORGE OS — mounts your other drives (Windows NTFS, exFAT, Linux) under /mnt/<name>.
# Runs as root at start-up (forge-drives.service) and again when you pick
# "Open drive" in Add a game. Safe to run any number of times.
#
#   Windows system partition (has Windows/System32) → read-only, so Windows is never harmed.
#   Every other drive → read-write, so games can save next to their files.
#   A drive Windows left "dirty" or hibernated → tries ntfs-3g, then read-only as a last resort.
set -u
LOG=/var/log/forge-drives.log
U=$(id -u forge 2>/dev/null || echo 1000); G=$(id -g forge 2>/dev/null || echo 1000)
OPTS_NTFS3="uid=$U,gid=$G,umask=022"
OPTS_NTFS3G="uid=$U,gid=$G,umask=022,windows_names"
log() { echo "[$(date '+%F %T')] $*" >> "$LOG"; }
# One status line per drive on stdout ("sda1: ..."), shown by "Add a game" if a drive won't open.
say() { echo "$(basename "$1"): $2"; }

modprobe ntfs3 2>/dev/null || modprobe ntfs 2>/dev/null

is_mounted() { findmnt -rn -S "$1" >/dev/null 2>&1; }

unique_dir() {
	local base="$1" n=2 d="/mnt/$1"
	# Reuse an existing empty folder of the same name (from an earlier boot).
	while [ -e "$d" ] && { mountpoint -q "$d" || [ -n "$(ls -A "$d" 2>/dev/null)" ]; }; do
		d="/mnt/${base}_$n"; n=$((n + 1))
	done
	echo "$d"
}

ERRDIR=/run/forge-drives        # last error per drive, shown by "Add a game" if a drive won't open
mkdir -p "$ERRDIR"

# One mount attempt; keeps its error message for the on-screen reason.
attempt() { # label dev dir mount-args...
	local label="$1" dev="$2" dir="$3"; shift 3
	local err
	if err=$("$@" 2>&1); then
		log "$dev → $dir ($label)"
		rm -f "$ERRDIR/$(basename "$dev")"
		return 0
	fi
	[ -n "$err" ] && { echo "$err" | tail -n1 > "$ERRDIR/$(basename "$dev")"; echo "$label: $err" >> "$LOG"; }
	return 1
}

try_mount() { # dev fstype dir
	local dev="$1" fs="$2" dir="$3"
	case "$fs" in
		ntfs)
			# Kernel drivers first (fast), then the ntfs-3g driver (works on almost anything).
			local drivers=() d
			grep -qw ntfs3 /proc/filesystems && drivers+=(ntfs3)
			grep -qw ntfs /proc/filesystems && drivers+=(ntfs)
			if [ "${WIN:-0}" = 1 ]; then
				for d in "${drivers[@]}"; do attempt "Windows, read-only, $d" "$dev" "$dir" mount -t "$d" -o "ro,$OPTS_NTFS3" "$dev" "$dir" && return 0; done
				attempt "Windows, read-only, ntfs-3g" "$dev" "$dir" ntfs-3g -o "ro,$OPTS_NTFS3G" "$dev" "$dir" && return 0
				return 1
			fi
			for d in "${drivers[@]}"; do attempt "$d" "$dev" "$dir" mount -t "$d" -o "rw,$OPTS_NTFS3" "$dev" "$dir" && return 0; done
			attempt "ntfs-3g" "$dev" "$dir" ntfs-3g -o "rw,$OPTS_NTFS3G" "$dev" "$dir" && return 0
			# Windows left it locked (hibernated / needs a disk check): open it read-only.
			for d in "${drivers[@]}"; do attempt "READ-ONLY $d: Windows left it locked" "$dev" "$dir" mount -t "$d" -o "ro,$OPTS_NTFS3" "$dev" "$dir" && return 0; done
			attempt "READ-ONLY ntfs-3g: Windows left it locked" "$dev" "$dir" ntfs-3g -o "ro,$OPTS_NTFS3G" "$dev" "$dir" && return 0
			return 1 ;;
		exfat|vfat)
			attempt "$fs" "$dev" "$dir" mount -o "rw,uid=$U,gid=$G,umask=022" "$dev" "$dir" && return 0
			return 1 ;;
		*)
			attempt "$fs" "$dev" "$dir" mount -o rw "$dev" "$dir" && { chown "$U:$G" "$dir" 2>/dev/null; return 0; }
			return 1 ;;
	esac
}

while read -r line; do
	L_PATH=""; L_FSTYPE=""; L_LABEL=""; L_SIZE=0; L_TYPE=""; L_PARTLABEL=""
	eval "$(echo "$line" | sed -E 's/(^| )(PATH|FSTYPE|LABEL|SIZE|TYPE|PARTLABEL)=/\1L_\2=/g')"
	dev="$L_PATH"; fs="$L_FSTYPE"
	[ "$L_TYPE" = "part" ] || continue
	case "$fs" in ntfs|exfat|vfat|ext4|btrfs|xfs|f2fs) ;; *) continue ;; esac
	[ "${L_SIZE:-0}" -gt $((4 * 1073741824)) ] || continue        # skip tiny/system partitions
	case "$L_PARTLABEL" in FORGE|FORGE_BOOT) continue ;; esac
	is_mounted "$dev" && { say "$dev" "already open at $(findmnt -rn -o TARGET -S "$dev" | head -n1)"; continue; }

	WIN=0
	if [ "$fs" = ntfs ]; then
		tmp=$(mktemp -d)
		if mount -t ntfs3 -o ro "$dev" "$tmp" 2>/dev/null || mount -t ntfs -o ro "$dev" "$tmp" 2>/dev/null || ntfs-3g -o ro "$dev" "$tmp" 2>/dev/null; then
			[ -d "$tmp/Windows/System32" ] && WIN=1
			umount "$tmp"
		fi
		rmdir "$tmp"
	fi

	name=$(echo "${L_LABEL:-}" | tr -cd 'A-Za-z0-9 _-' | sed 's/^ *//; s/ *$//' | tr ' ' '_')
	[ -n "$name" ] || name="Drive_$(basename "$dev")"
	[ "$WIN" = 1 ] && [ -z "${L_LABEL:-}" ] && name="Windows"
	dir=$(unique_dir "$name")
	mkdir -p "$dir"
	if try_mount "$dev" "$fs" "$dir"; then
		say "$dev" "opened at $dir"
	else
		log "$dev: could not mount ($fs)"
		say "$dev" "failed: $(cat "$ERRDIR/$(basename "$dev")" 2>/dev/null || echo "no reason given")"
		rmdir "$dir" 2>/dev/null
	fi
done < <(lsblk -lnbpP -o PATH,FSTYPE,LABEL,SIZE,TYPE,PARTLABEL)

# Clean up empty leftover folders so the game picker only shows real drives.
for d in /mnt/*/; do
	d="${d%/}"
	[ -d "$d" ] || continue
	mountpoint -q "$d" || rmdir "$d" 2>/dev/null
done
exit 0
