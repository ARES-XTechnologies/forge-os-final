#!/bin/bash
# FORGE OS — recovery mode. Chosen from the boot menu (hold Space while the console starts).
# A simple menu to fix the common problems without reinstalling.

BT="FORGE OS Recovery  ·  Blacksmith Games"
D=(dialog --backtitle "$BT" --colors)
CONF="$HOME/.config/forge/session.conf"
GODOT_DATA="$HOME/.local/share/godot/app_userdata/FORGE OS"
setfont ter-128b 2>/dev/null || true
exec 3>&1

while true; do
	choice=$("${D[@]}" --title " Recovery " --cancel-label "Restart" --menu "\nWhat's wrong?" 22 74 10 \
		display  "The screen is black or flickers (reset to 1080p 60 Hz)" \
		undo     "It broke after a FORGE update (go back one version)" \
		repair   "Repair and update the system (needs internet)" \
		settings "Reset FORGE settings (keeps profiles' games)" \
		steam    "Steam won't sign in (sign out of Steam)" \
		network  "Connect to Wi-Fi" \
		bigpic   "Start Steam Big Picture instead of FORGE" \
		shell    "Open a terminal (advanced)" \
		start    "Start FORGE normally" \
		poweroff "Power off" 2>&1 1>&3) || { sudo systemctl reboot; exit 0; }
	case "$choice" in
		display)
			mkdir -p "$(dirname "$CONF")"
			printf 'WIDTH=1920\nHEIGHT=1080\nREFRESH=60\nHDR=0\nVRR=0\nINTRO=1\n' > "$CONF"
			"${D[@]}" --msgbox "\nDisplay reset to 1920 × 1080 at 60 Hz." 8 50 ;;
		undo)
			if sudo /usr/lib/forge/forge-helper rollback; then
				"${D[@]}" --msgbox "\nWent back to the previous FORGE version." 8 54
			else
				"${D[@]}" --msgbox "\nThere's no previous version saved." 8 50
			fi ;;
		repair)
			clear
			echo "Repairing… this can take a while."
			sudo /usr/lib/forge/forge-helper update && echo "Done." || echo "Failed: check the internet connection."
			read -rp "Press Enter to continue" _ ;;
		settings)
			"${D[@]}" --yesno "\nReset all FORGE settings and profiles?\nGames and Steam are not touched." 9 56 && rm -rf "$GODOT_DATA" "$CONF" && "${D[@]}" --msgbox "\nSettings reset. Setup runs on the next start." 8 52 ;;
		steam)
			rm -f "$HOME/.local/share/Steam/config/loginusers.vdf"
			sed -i '/AutoLoginUser/d' "$HOME/.steam/registry.vdf" 2>/dev/null
			"${D[@]}" --msgbox "\nSigned out of Steam. Sign in again when FORGE starts." 8 58 ;;
		network)
			nmtui ;;
		bigpic)
			exec gamescope -f -- steam -gamepadui ;;
		shell)
			clear
			echo "Type 'exit' to return to the recovery menu."
			bash ;;
		start)
			exec /usr/lib/forge/forge-session ;;
		poweroff)
			sudo systemctl poweroff; exit 0 ;;
	esac
done
